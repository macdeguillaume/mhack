---
import CTA from "./CTA.astro";
---

<section class="relative min-h-screen flex items-center justify-center grain overflow-hidden">
  <!-- Gradient background -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(184,134,11,0.06)_0%,_transparent_70%)]"
  ></div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center pt-24 pb-20">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 bg-gold/10 border border-gold/20 rounded-full px-4 py-1.5 mb-8">
      <span class="w-2 h-2 bg-gold rounded-full animate-pulse"></span>
      <span class="text-sm text-gold font-medium">Head of Sales end zone</span>
    </div>

    <!-- H1 -->
    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-tight mb-6">
      On construit votre système et on appelle.
      <br />
      <span class="text-gold">Vous prenez les rendez-vous.</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-text-muted max-w-2xl mx-auto mb-10">
      On est au lineup chaque matin pour vous décrocher des RDV qualifiés. 🏄
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <CTA text="Réserver un call" variant="primary" calendly />
      <CTA text="Voir nos résultats ↓" variant="secondary" href="#resultats" />
    </div>

    <!-- Hero stat -->
    <div class="inline-flex items-center gap-3 bg-bg-card/60 border border-border rounded-xl px-6 py-4">
      <span class="font-display text-3xl md:text-4xl font-bold text-gold">20%</span>
      <div class="text-left">
        <p class="text-sm text-text font-medium">d'appels connectés</p>
        <p class="text-xs text-text-muted">vs 4-7% moyenne industrie</p>
      </div>
    </div>
  </div>
</section>
