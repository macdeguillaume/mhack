---
import { clients, clientCount } from "../data/clients";
---

<section class="py-16 border-y border-border overflow-hidden">
  <div class="mx-auto max-w-6xl px-6 mb-8">
    <p class="text-center text-text-muted text-sm">
      Ils nous font confiance — <span class="text-gold font-semibold">+{clientCount} entreprises</span> accompagnées
    </p>
  </div>

  <!-- Marquee -->
  <div class="relative">
    <div class="flex animate-marquee whitespace-nowrap">
      {[...clients, ...clients].map((client) => (
        <div class="mx-10 flex items-center justify-center min-w-[120px] opacity-40 hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
          <span class="font-display text-xl font-bold text-text-muted">{client.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
