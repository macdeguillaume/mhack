---
const steps = [
  {
    number: "01",
    title: "Audit stratégique & ICP",
    description:
      "On analyse votre marché, vos buyers, votre cycle de vente. On construit l'ICP ensemble, on structure le CRM, on prépare la data.",
  },
  {
    number: "02",
    title: "Scripts & systèmes",
    description:
      "Rédaction de scripts d'appel testés sur votre verticale. Setup complet : séquences, enrichissement, tracking, CRM configuré pour closer.",
  },
  {
    number: "03",
    title: "Appels & itérations",
    description:
      "On décroche le téléphone. Chaque appel est tracké, chaque objection documentée, chaque script itéré. Data-driven, pas au feeling.",
  },
  {
    number: "04",
    title: "RDV qualifiés dans votre agenda",
    description:
      "Vous recevez des rendez-vous avec des décideurs qualifiés, briefés et prêts à discuter. Pas des leads tièdes à relancer 10 fois.",
  },
];
---

<section id="methode" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <div class="text-center mb-16 reveal">
      <h2 class="font-display text-3xl md:text-4xl font-bold mb-4">
        Un Head of Sales externalisé,<br/>
        <span class="text-gold">pas une agence de calls</span>
      </h2>
      <p class="text-text-muted max-w-2xl mx-auto">
        Vous n'obtenez pas juste des appels. Vous obtenez la stratégie, les systèmes et l'exécution d'un Head of Sales senior — sans le recruter.
      </p>
    </div>

    <!-- Steps grid -->
    <div class="grid md:grid-cols-2 gap-6 mb-20">
      {steps.map((step, i) => (
        <div
          class="reveal bg-bg-card border border-border rounded-xl p-8 hover:border-gold/50 transition-colors"
          style={`transition-delay: ${i * 100}ms`}
        >
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gold/10 text-gold font-display font-bold text-sm mb-4">
            {step.number}
          </span>
          <h3 class="font-display text-lg font-semibold mb-2">{step.title}</h3>
          <p class="text-text-muted text-sm leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    <!-- Comparatif SDR vs lineup -->
    <div class="reveal">
      <h3 class="font-display text-2xl md:text-3xl font-bold text-center mb-12">
        Recruter un SDR, ou confier vos appels <span class="text-gold">à un expert</span>
      </h3>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- SDR interne -->
        <div class="bg-bg-card border border-border rounded-xl p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-text-muted"></span>
            <h4 class="font-display text-lg font-semibold">SDR interne</h4>
          </div>
          <ul class="space-y-4">
            {[
              { label: "Coût annuel", value: "60-80k€ chargé" },
              { label: "Temps avant résultats", value: "3-6 mois" },
              { label: "Risque turnover", value: "Élevé (< 18 mois en moyenne)" },
              { label: "Stratégie outbound", value: "À construire vous-même" },
              { label: "Setup CRM & data", value: "À votre charge" },
              { label: "Taux de connexion", value: "4-7% en moyenne" },
            ].map((row) => (
              <li class="flex justify-between items-start border-b border-border pb-3 last:border-0">
                <span class="text-text-muted text-sm">{row.label}</span>
                <span class="text-sm text-text font-medium text-right">{row.value}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- lineup -->
        <div class="bg-bg-card border border-gold ring-1 ring-gold/30 rounded-xl p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-3 h-3 rounded-full bg-gold"></span>
            <h4 class="font-display text-lg font-semibold">lineup — Head of Sales qui cold call</h4>
          </div>
          <ul class="space-y-4">
            {[
              { label: "Coût mensuel", value: "À partir de 2 900€/mois" },
              { label: "Temps avant résultats", value: "Semaine 1" },
              { label: "Risque turnover", value: "Zéro" },
              { label: "Stratégie outbound", value: "Incluse (ICP, scripts, séquences)" },
              { label: "Setup CRM & data", value: "Inclus et optimisé" },
              { label: "Taux de connexion", value: "20% garanti" },
            ].map((row) => (
              <li class="flex justify-between items-start border-b border-border pb-3 last:border-0">
                <span class="text-text-muted text-sm">{row.label}</span>
                <span class="text-sm text-gold font-semibold text-right">{row.value}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
