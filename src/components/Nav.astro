---
const links = [
  { label: "Problème", href: "#probleme" },
  { label: "Méthode", href: "#methode" },
  { label: "Résultats", href: "#resultats" },
  { label: "Offres", href: "#offres" },
  { label: "À propos", href: "#apropos" },
];
---

<nav
  id="nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="text-2xl font-display font-bold tracking-tight">
      <span class="text-gold">line</span>up
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-muted hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
      <button
        data-calendly="true"
        class="bg-white hover:bg-accent-hover text-bg text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors cursor-pointer"
      >
        Réserver un call
      </button>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-1.5 cursor-pointer p-1"
      aria-label="Menu"
    >
      <span class="block w-6 h-0.5 bg-text transition-all" id="bar1"></span>
      <span class="block w-6 h-0.5 bg-text transition-all" id="bar2"></span>
      <span class="block w-6 h-0.5 bg-text transition-all" id="bar3"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden fixed inset-0 top-[72px] bg-bg/95 backdrop-blur-md z-40"
  >
    <div class="flex flex-col items-center gap-8 pt-16">
      {links.map((link) => (
        <a
          href={link.href}
          class="text-lg text-text-muted hover:text-text transition-colors mobile-link"
        >
          {link.label}
        </a>
      ))}
      <button
        data-calendly="true"
        class="bg-white hover:bg-accent-hover text-bg font-semibold px-7 py-3 rounded-lg transition-colors cursor-pointer"
      >
        Réserver un call
      </button>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")!;
  const bar1 = document.getElementById("bar1")!;
  const bar2 = document.getElementById("bar2")!;
  const bar3 = document.getElementById("bar3")!;
  let open = false;

  // Scroll effect
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      nav.classList.add("bg-bg/80", "backdrop-blur-md", "border-b", "border-border");
    } else {
      nav.classList.remove("bg-bg/80", "backdrop-blur-md", "border-b", "border-border");
    }
  });

  // Mobile menu toggle
  toggle.addEventListener("click", () => {
    open = !open;
    menu.classList.toggle("hidden");
    document.body.style.overflow = open ? "hidden" : "";
    bar1.style.transform = open ? "rotate(45deg) translate(4px, 4px)" : "";
    bar2.style.opacity = open ? "0" : "1";
    bar3.style.transform = open ? "rotate(-45deg) translate(4px, -4px)" : "";
  });

  // Close menu on link click
  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      open = false;
      menu.classList.add("hidden");
      document.body.style.overflow = "";
      bar1.style.transform = "";
      bar2.style.opacity = "1";
      bar3.style.transform = "";
    });
  });
</script>
