---
interface Props {
  text: string;
  variant?: "primary" | "secondary";
  href?: string;
  calendly?: boolean;
}

const { text, variant = "primary", href, calendly = false } = Astro.props;
const tag = href ? "a" : "button";
const classes =
  variant === "primary"
    ? "bg-white hover:bg-accent-hover text-bg font-semibold"
    : "border border-border hover:border-gold text-text hover:text-gold";
---

{tag === "a" ? (
  <a
    href={href}
    class:list={[
      "inline-flex items-center justify-center px-7 py-3.5 rounded-lg text-base transition-all duration-200 cursor-pointer",
      classes,
    ]}
    data-calendly={calendly ? "true" : undefined}
  >
    {text}
  </a>
) : (
  <button
    class:list={[
      "inline-flex items-center justify-center px-7 py-3.5 rounded-lg text-base transition-all duration-200 cursor-pointer",
      classes,
    ]}
    data-calendly={calendly ? "true" : undefined}
  >
    {text}
  </button>
)}
